{
  "name": "@actualwave/primitive-type-checker",
  "description": "Runtime type check for primitive value types (uses typeof and identifies arrays).",
  "version": "0.2.3",
  "main": "index.js",
  "types": "types/index.d.ts",
  "keywords": [
    "js",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/burdiuz/js-primitive-type-checker",
  "bugs": {
    "url": "https://github.com/burdiuz/js-primitive-type-checker/issues",
    "email": "burdiuz@gmail.com"
  },
  "license": "MIT",
  "author": "Oleg Galaburda <burdiuz@gmail.com> (http://actualwave.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/burdiuz/js-primitive-type-checker.git"
  },
  "dependencies": {
    "@actualwave/type-checker-levels-storage": "0.0.3",
    "@actualwave/type-checker-simple-reporting": "0.0.3"
  },
  "peerDependencies": {
    "@actualwave/type-checkers": "^0.2.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "coveralls": "^3.1.1",
    "jest": "^29.7.0",
    "rollup": "^4.60.3",
    "rollup-plugin-copy": "^3.5.0",
    "ts-jest": "^29.4.9",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "transform": { "^.+\\.tsx?$": "ts-jest" },
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.spec.ts"],
    "collectCoverage": true,
    "coverageReporters": ["json", "lcov", "text"],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.spec.ts",
      "!**/node_modules/**"
    ]
  },
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "build:watch": "rollup --config rollup.config.mjs --watch",
    "test": "jest --colors",
    "test:watch": "jest --colors --watch",
    "coveralls": "jest --colors && cat coverage/lcov.info | coveralls"
  }
}
